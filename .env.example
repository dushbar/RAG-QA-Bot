# Copy this file to .env and fill in the provider you want to use.
# Embeddings are always local/free (sentence-transformers) — only the
# answer-generation step calls a paid LLM API.

# ---- Pick ONE provider ----
LLM_PROVIDER=anthropic          # "anthropic" or "openai"

# Anthropic (used if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI (used if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Optional tuning (sane defaults if omitted) ----
PERSIST_DIR=./data/vectorstore
DEFAULT_COLLECTION=default
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
